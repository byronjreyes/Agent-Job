{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentJob",
  "version": "0.1.0",
  "identifier": "app.agentjob.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentJob",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCRTQ4RjgyMzYzOTg0RUMKUldUc2hEazJnby9raXl5VjluaGlTY1FRbHIyTzFDTkkxSXJISDU3L29pWUoyYzBqQVlkWUthZEoK",
      "endpoints": [
        "https://github.com/byronjreyes/Agent-Job/releases/latest/download/latest.json"
      ]
    }
  }
}

